# IA usada para entender os pedidos: "gemini" (tem plano gratuito) ou "anthropic" (Claude, pago).
# Vazio = usa a que tiver chave preenchida abaixo.
LLM_PROVIDER=gemini
# Chave do Gemini (gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-flash-latest)
GEMINI_MODEL=
# Chave da API da Anthropic, se for usar o Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Token do bot do Telegram (fale com @BotFather no Telegram e use /newbot)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Opcional: IDs de usuários do Telegram autorizados, separados por vírgula.
# Deixe vazio na primeira vez; o bot mostra seu ID quando você mandar /start.
ALLOWED_USER_IDS=
# Pasta onde ficam os áudios baixados e os medleys gerados
DATA_DIR=./data
# Apaga áudios e medleys não usados há mais de N dias (0 = nunca apagar)
KEEP_DAYS=30
# Opcional: arquivo de cookies do YouTube (formato Netscape), caso o servidor seja bloqueado.
# Coloque o arquivo dentro da pasta data/ e use: YTDLP_COOKIES=/app/data/cookies.txt
YTDLP_COOKIES=
# Atualiza o yt-dlp toda vez que o container inicia (1 = sim, 0 = não)
YTDLP_AUTO_UPDATE=1
